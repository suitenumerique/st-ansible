{# transfers frontend (Caddy) runtime env — the image bundles Caddy, which serves the
   built SPA and reverse-proxies /api,/admin,/static,/__heartbeat__ to the backend. #}
TRANSFERS_FRONTEND_BACKEND_SERVER=transfers-backend:8000
{# Proxies whose X-Forwarded-For Caddy believes. Upstream ships no default; narrowing
   or removing this needs docs/07-transfers "Client IPs behind the balancer". #}
TRANSFERS_FRONTEND_TRUSTED_PROXIES=private_ranges
{# S3 origin the browser fetches presigned URLs from — needed in the frontend CSP. #}
{% if answers.TRANSFERS_FRONTEND_S3_ORIGIN %}TRANSFERS_FRONTEND_S3_ORIGIN={{ answers.TRANSFERS_FRONTEND_S3_ORIGIN }}
{% endif %}
