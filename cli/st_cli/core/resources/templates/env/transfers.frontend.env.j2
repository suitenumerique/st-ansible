{# transfers frontend (Caddy) runtime env — the image bundles Caddy, which serves
   the built SPA and reverse-proxies /api,/admin,/static,/__heartbeat__ to the
   backend container (default localhost:8000 must point at the backend service). #}
TRANSFERTS_FRONTEND_BACKEND_SERVER=transfers-backend:8000
{# S3 origin the browser fetches presigned upload/download URLs from — needed in
   the frontend Content-Security-Policy. Derived from the S3 endpoint in bootstrap. #}
{% if answers.TRANSFERTS_FRONTEND_S3_ORIGIN %}TRANSFERTS_FRONTEND_S3_ORIGIN={{ answers.TRANSFERTS_FRONTEND_S3_ORIGIN }}
{% endif %}
