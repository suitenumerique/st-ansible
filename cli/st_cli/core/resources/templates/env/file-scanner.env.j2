{# file-scanner env — one file shared by the API (uvicorn) and the dramatiq worker.
   CLAMAV_HOSTS targets the clamav service bundled in the role's compose stack (a
   fixed service DNS name), so it is emitted here rather than prompted; the dramatiq
   broker is an EXTERNAL Redis, prompted at bootstrap. Every other knob keeps its
   upstream default — see env_docs_url. #}
CLAMAV_HOSTS=clamav:3310
WORKER_BROKER_URL={{ answers.WORKER_BROKER_URL }}
{# Callers are trusted via their PUBLIC Ed25519 keys (iss:base64url-pubkey pairs);
   the signing seed below signs outgoing webhooks (public half at /.well-known/jwks.json). #}
JWT_ISSUER_KEYS={{ answers.JWT_ISSUER_KEYS }}
JWT_SIGNING_KEY={{ answers.JWT_SIGNING_KEY }}
JWT_SIGNING_KID={{ answers.JWT_SIGNING_KID }}
{% if answers.PROMETHEUS_API_KEY %}PROMETHEUS_API_KEY={{ answers.PROMETHEUS_API_KEY }}
{% endif %}
{% if answers.ALLOWED_URL_HOSTS %}ALLOWED_URL_HOSTS={{ answers.ALLOWED_URL_HOSTS }}
{% endif %}
{% if answers.SSRF_ALLOWED_HOSTS %}SSRF_ALLOWED_HOSTS={{ answers.SSRF_ALLOWED_HOSTS }}
{% endif %}
