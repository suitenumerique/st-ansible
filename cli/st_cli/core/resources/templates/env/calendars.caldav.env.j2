{# calendars CalDAV server (SabreDAV). It reads the Django database from the
   discrete PG* vars and shares the three CALDAV_*_API_KEY secrets with the
   backend. #}
PGHOST={{ answers.DB_HOST }}
PGPORT={{ answers.DB_PORT }}
PGDATABASE={{ answers.DB_NAME }}
PGUSER={{ answers.DB_USER }}
PGPASSWORD={{ answers.DB_PASSWORD }}
CALDAV_DB_SCHEMA={{ answers.CALDAV_DB_SCHEMA }}
CALDAV_BASE_URI={{ answers.CALDAV_BASE_URI }}
CALDAV_INBOUND_API_KEY={{ answers.CALDAV_INBOUND_API_KEY }}
CALDAV_OUTBOUND_API_KEY={{ answers.CALDAV_OUTBOUND_API_KEY }}
CALDAV_INTERNAL_API_KEY={{ answers.CALDAV_INTERNAL_API_KEY }}
CALDAV_CALLBACK_BASE_URL={{ answers.CALDAV_CALLBACK_BASE_URL }}
