{# projects (a Planka fork) env — a Sails.js app, NOT Django, so it shares nothing
   with base.django.env.j2. Rendered as a plain dotenv body; the role wraps it with
   its own ansible_managed header. OIDC is enforced (SSO only, no local accounts).
   Optional keys are only emitted when set in answers. #}
BASE_URL={{ answers.BASE_URL }}
DATABASE_URL={{ answers.DATABASE_URL }}
SECRET_KEY={{ answers.SECRET_KEY }}
ALLOW_ALL_TO_CREATE_PROJECTS={{ answers.ALLOW_ALL_TO_CREATE_PROJECTS }}
{# OpenID Connect — required (OIDC_ENFORCED=true, login has no local fallback) #}
OIDC_ISSUER={{ answers.OIDC_ISSUER }}
OIDC_CLIENT_ID={{ answers.OIDC_CLIENT_ID }}
OIDC_CLIENT_SECRET={{ answers.OIDC_CLIENT_SECRET }}
OIDC_ENFORCED={{ answers.OIDC_ENFORCED }}
OIDC_SCOPES={{ answers.OIDC_SCOPES }}
OIDC_USE_DEFAULT_RESPONSE_MODE={{ answers.OIDC_USE_DEFAULT_RESPONSE_MODE }}
{% if answers.OIDC_USERINFO_SIGNED_RESPONSE_ALG %}OIDC_USERINFO_SIGNED_RESPONSE_ALG={{ answers.OIDC_USERINFO_SIGNED_RESPONSE_ALG }}
{% endif %}
OIDC_FULLNAME_ATTRIBUTES={{ answers.OIDC_FULLNAME_ATTRIBUTES }}
OIDC_IGNORE_USERNAME={{ answers.OIDC_IGNORE_USERNAME }}
OIDC_IGNORE_ROLES={{ answers.OIDC_IGNORE_ROLES }}
{% if answers.ORGANIZATION_ID_CLAIM %}ORGANIZATION_ID_CLAIM={{ answers.ORGANIZATION_ID_CLAIM }}
{% endif %}
{# Object storage (S3) — the recommended target for uploads (avatars, project
   backgrounds, attachments). Emitted only when an endpoint is configured. #}
{% if answers.S3_ENDPOINT %}
S3_ENDPOINT={{ answers.S3_ENDPOINT }}
{% if answers.S3_REGION %}S3_REGION={{ answers.S3_REGION }}
{% endif %}
S3_ACCESS_KEY_ID={{ answers.S3_ACCESS_KEY_ID }}
S3_SECRET_ACCESS_KEY={{ answers.S3_SECRET_ACCESS_KEY }}
S3_BUCKET={{ answers.S3_BUCKET }}
{% if answers.S3_FORCE_PATH_STYLE %}S3_FORCE_PATH_STYLE={{ answers.S3_FORCE_PATH_STYLE }}
{% endif %}
{% endif %}
{# Email (SMTP) — only emitted when configured in bootstrap #}
{% if answers.SMTP_HOST %}
SMTP_HOST={{ answers.SMTP_HOST }}
SMTP_PORT={{ answers.SMTP_PORT }}
{% if answers.SMTP_SECURE %}SMTP_SECURE={{ answers.SMTP_SECURE }}
{% endif %}
{% if answers.SMTP_USER %}SMTP_USER={{ answers.SMTP_USER }}
SMTP_PASSWORD={{ answers.SMTP_PASSWORD }}
{% endif %}
SMTP_FROM={{ answers.SMTP_FROM }}
{% endif %}
