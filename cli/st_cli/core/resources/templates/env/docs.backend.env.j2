{% include "base.django.env.j2" %}
{# docs backend overlay #}
{% if answers.OIDC_REDIRECT_ALLOWED_HOSTS %}OIDC_REDIRECT_ALLOWED_HOSTS={{ answers.OIDC_REDIRECT_ALLOWED_HOSTS }}
{% endif %}
{% if answers.COLLABORATION_WS_URL %}COLLABORATION_WS_URL={{ answers.COLLABORATION_WS_URL }}
{% endif %}
{% if answers.COLLABORATION_API_URL %}COLLABORATION_API_URL={{ answers.COLLABORATION_API_URL }}
{% endif %}
{% if answers.COLLABORATION_SERVER_SECRET %}COLLABORATION_SERVER_SECRET={{ answers.COLLABORATION_SERVER_SECRET }}
{% endif %}
{% if answers.Y_PROVIDER_API_BASE_URL %}# Backend-only (the browser never calls it): the backend uses this URL to
# convert uploaded .md/.docx files on import, to export document content as
# markdown/html/json, and for server-to-server document creation. If you have
# an internal load balancer, put its URL here to spread the calls over all the
# yprovider hosts.
Y_PROVIDER_API_BASE_URL={{ answers.Y_PROVIDER_API_BASE_URL }}
{% endif %}
{% if answers.Y_PROVIDER_API_KEY %}Y_PROVIDER_API_KEY={{ answers.Y_PROVIDER_API_KEY }}
{% endif %}
{% if answers.CONVERSION_UPLOAD_ENABLED %}# Enables the document import feature (upload of .md/.docx files). The backend
# converts .docx via the docspec container in the docs compose.
CONVERSION_UPLOAD_ENABLED={{ answers.CONVERSION_UPLOAD_ENABLED }}
{% endif %}
{% if answers.DOCSPEC_API_URL %}DOCSPEC_API_URL={{ answers.DOCSPEC_API_URL }}
{% endif %}
{% if answers.DJANGO_EMAIL_URL_APP %}DJANGO_EMAIL_URL_APP={{ answers.DJANGO_EMAIL_URL_APP }}
{% endif %}
{% if answers.FRONTEND_THEME %}FRONTEND_THEME={{ answers.FRONTEND_THEME }}
{% endif %}
{% if answers.FRONTEND_CSS_URL %}FRONTEND_CSS_URL={{ answers.FRONTEND_CSS_URL }}
{% endif %}
