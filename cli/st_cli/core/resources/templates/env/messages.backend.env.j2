{% include "base.django.env.j2" %}
{# messages backend overlay #}
{# messages (unlike meet/drive) does not auto-create users on OIDC login by
   default; without this a first-time OIDC/ProConnect login is silently
   rejected. A created user with no MailboxAccess can access nothing. #}
OIDC_CREATE_USER=true
{# messages sits behind the frontend Caddy + edge LB; trust X-Forwarded-For so
   REMOTE_ADDR (access logs / throttling) reflects the forwarded client IP
   rather than the proxy container. #}
USE_X_FORWARDED_FOR=true
MDA_API_SECRET={{ answers.MDA_API_SECRET }}
{% if answers.SALT_KEY %}SALT_KEY={{ answers.SALT_KEY }}
{% endif %}
{% if answers.MTA_OUT_MODE %}MTA_OUT_MODE={{ answers.MTA_OUT_MODE }}
{% endif %}
{% if answers.MTA_OUT_RELAY_HOST %}MTA_OUT_RELAY_HOST={{ answers.MTA_OUT_RELAY_HOST }}
{% endif %}
{% if answers.MTA_OUT_RELAY_USERNAME %}MTA_OUT_RELAY_USERNAME={{ answers.MTA_OUT_RELAY_USERNAME }}
{% endif %}
{% if answers.MTA_OUT_RELAY_PASSWORD %}MTA_OUT_RELAY_PASSWORD={{ answers.MTA_OUT_RELAY_PASSWORD }}
{% endif %}
{% if answers.MTA_OUT_DIRECT_PROXIES %}MTA_OUT_DIRECT_PROXIES={{ answers.MTA_OUT_DIRECT_PROXIES }}
{% endif %}
{% if answers.SPAM_CONFIG %}SPAM_CONFIG={{ answers.SPAM_CONFIG }}
