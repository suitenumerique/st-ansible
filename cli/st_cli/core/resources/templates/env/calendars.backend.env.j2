{% include "base.django.env.j2" %}
{# calendars backend overlay. Background tasks run on dramatiq. The SMTP keys
   are the plain Django ones, not DJANGO_EMAIL_*. #}
DRAMATIQ_BROKER_URL={{ answers.DRAMATIQ_BROKER_URL }}
DRAMATIQ_RESULT_BACKEND_URL={{ answers.DRAMATIQ_RESULT_BACKEND_URL }}
SALT_KEY={{ answers.SALT_KEY }}
APP_URL={{ answers.APP_URL }}
CALDAV_URL={{ answers.CALDAV_URL }}
CALDAV_INBOUND_API_KEY={{ answers.CALDAV_INBOUND_API_KEY }}
CALDAV_OUTBOUND_API_KEY={{ answers.CALDAV_OUTBOUND_API_KEY }}
CALDAV_INTERNAL_API_KEY={{ answers.CALDAV_INTERNAL_API_KEY }}
{% if answers.EMAIL_HOST %}EMAIL_HOST={{ answers.EMAIL_HOST }}
{% endif %}
{% if answers.EMAIL_PORT %}EMAIL_PORT={{ answers.EMAIL_PORT }}
{% endif %}
{% if answers.EMAIL_HOST_USER %}EMAIL_HOST_USER={{ answers.EMAIL_HOST_USER }}
{% endif %}
{% if answers.EMAIL_HOST_PASSWORD %}EMAIL_HOST_PASSWORD={{ answers.EMAIL_HOST_PASSWORD }}
{% endif %}
{% if answers.EMAIL_USE_TLS %}EMAIL_USE_TLS={{ answers.EMAIL_USE_TLS }}
{% endif %}
{% if answers.EMAIL_USE_SSL %}EMAIL_USE_SSL={{ answers.EMAIL_USE_SSL }}
{% endif %}
{% if answers.DEFAULT_FROM_EMAIL %}DEFAULT_FROM_EMAIL={{ answers.DEFAULT_FROM_EMAIL }}
{% endif %}
