{% include "base.django.env.j2" %}
{# transfers backend overlay. It reuses the django-lasuite base (DB / Redis /
   OIDC / AWS_S3_* incl. AWS_STORAGE_BUCKET_NAME / SMTP) and adds a few extras. #}
{% if answers.USE_X_FORWARDED_FOR %}USE_X_FORWARDED_FOR={{ answers.USE_X_FORWARDED_FOR }}
{% endif %}
{# transfers uses DEFAULT_FROM_EMAIL rather than DJANGO_EMAIL_FROM for the sender. #}
{% if answers.DJANGO_EMAIL_FROM %}DEFAULT_FROM_EMAIL={{ answers.DJANGO_EMAIL_FROM }}
{% endif %}
{# Optional Drive integration (file picker). Emitted only when a base URL is set. #}
{% if answers.DRIVE_BASE_URL %}DRIVE_BASE_URL={{ answers.DRIVE_BASE_URL }}
{% endif %}
