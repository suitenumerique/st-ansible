{% include "base.django.env.j2" %}
{# transfers backend overlay. It reuses the django-lasuite base as-is (DB / Redis /
   OIDC / AWS_S3_* incl. AWS_STORAGE_BUCKET_NAME / SMTP incl. the DJANGO_EMAIL_FROM
   sender) and only adds a few transfers-specific extras. #}
{% if answers.USE_X_FORWARDED_FOR %}USE_X_FORWARDED_FOR={{ answers.USE_X_FORWARDED_FOR }}
{% endif %}
{# Optional Drive integration (file picker). Emitted only when a base URL is set. #}
{% if answers.DRIVE_BASE_URL %}DRIVE_BASE_URL={{ answers.DRIVE_BASE_URL }}
{% endif %}
{# Optional file-scanner (antivirus) integration — emitted only when enabled. The
   external scanner service scans completed uploads and gates downloads via a
   webhook; SCAN_JWT_PRIVATE_KEY is the EdDSA key signing the scan-submit JWTs. #}
{% if answers.SCAN_ENABLED %}
SCAN_ENABLED={{ answers.SCAN_ENABLED }}
SCAN_SERVICE_URL={{ answers.SCAN_SERVICE_URL }}
SCAN_JWT_PRIVATE_KEY={{ answers.SCAN_JWT_PRIVATE_KEY }}
SCAN_JWT_ISSUER={{ answers.SCAN_JWT_ISSUER }}
SCAN_JWT_AUDIENCE={{ answers.SCAN_JWT_AUDIENCE }}
SCAN_WEBHOOK_BASE_URL={{ answers.SCAN_WEBHOOK_BASE_URL }}
{# Tuning knobs: upstream ships a default for each (SCAN_JWT_TTL 300s,
   SCAN_MAX_FILE_SIZE 2 GiB, SCAN_PRESIGNED_URL_EXPIRY 3600s,
   SCAN_PENDING_REAP_MINUTES 15), so a line is written ONLY when the operator
   deviates — writing them at their default would pin our copy of upstream's
   value and mask a later change on their side. #}
{% if answers.SCAN_JWT_TTL %}SCAN_JWT_TTL={{ answers.SCAN_JWT_TTL }}
{% endif %}
{% if answers.SCAN_MAX_FILE_SIZE %}SCAN_MAX_FILE_SIZE={{ answers.SCAN_MAX_FILE_SIZE }}
{% endif %}
{% if answers.SCAN_PRESIGNED_URL_EXPIRY %}SCAN_PRESIGNED_URL_EXPIRY={{ answers.SCAN_PRESIGNED_URL_EXPIRY }}
{% endif %}
{% if answers.SCAN_PENDING_REAP_MINUTES %}SCAN_PENDING_REAP_MINUTES={{ answers.SCAN_PENDING_REAP_MINUTES }}
{% endif %}
{% endif %}
