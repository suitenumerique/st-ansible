{# Base env blob shared by every django-backend component (meet / drive / messages).
   Rendered as a plain dotenv body; the consumer role wraps it with its own
   ansible_managed header. Optional keys are only emitted when set in answers. #}
DJANGO_SETTINGS_MODULE={{ answers.DJANGO_SETTINGS_MODULE }}
DJANGO_CONFIGURATION={{ answers.DJANGO_CONFIGURATION }}
DJANGO_SECRET_KEY={{ answers.DJANGO_SECRET_KEY }}
DJANGO_ALLOWED_HOSTS={{ answers.DJANGO_ALLOWED_HOSTS }}
{% if answers.DJANGO_SILENCED_SYSTEM_CHECKS %}DJANGO_SILENCED_SYSTEM_CHECKS={{ answers.DJANGO_SILENCED_SYSTEM_CHECKS }}
{% endif %}
{% if answers.DJANGO_CSRF_TRUSTED_ORIGINS %}DJANGO_CSRF_TRUSTED_ORIGINS={{ answers.DJANGO_CSRF_TRUSTED_ORIGINS }}
{% endif %}
{% if answers.DATABASE_URL %}DATABASE_URL={{ answers.DATABASE_URL }}
{% endif %}
{% if answers.DB_HOST %}DB_HOST={{ answers.DB_HOST }}
DB_NAME={{ answers.DB_NAME }}
DB_USER={{ answers.DB_USER }}
DB_PASSWORD={{ answers.DB_PASSWORD }}
{% if answers.DB_PORT %}DB_PORT={{ answers.DB_PORT }}
{% endif %}
{% endif %}
REDIS_URL={{ answers.REDIS_URL }}
CELERY_BROKER_URL={{ answers.CELERY_BROKER_URL }}
{% if answers.CELERY_TASK_DEFAULT_QUEUE %}CELERY_TASK_DEFAULT_QUEUE={{ answers.CELERY_TASK_DEFAULT_QUEUE }}
{% endif %}
OIDC_RP_CLIENT_ID={{ answers.OIDC_RP_CLIENT_ID }}
OIDC_RP_CLIENT_SECRET={{ answers.OIDC_RP_CLIENT_SECRET }}
{% if answers.OIDC_RP_SIGN_ALGO %}OIDC_RP_SIGN_ALGO={{ answers.OIDC_RP_SIGN_ALGO }}
{% endif %}
{% if answers.OIDC_RP_SCOPES %}OIDC_RP_SCOPES={{ answers.OIDC_RP_SCOPES }}
{% endif %}
OIDC_OP_JWKS_ENDPOINT={{ answers.OIDC_OP_JWKS_ENDPOINT }}
OIDC_OP_AUTHORIZATION_ENDPOINT={{ answers.OIDC_OP_AUTHORIZATION_ENDPOINT }}
{% if answers.OIDC_OP_TOKEN_ENDPOINT %}OIDC_OP_TOKEN_ENDPOINT={{ answers.OIDC_OP_TOKEN_ENDPOINT }}
{% endif %}
{% if answers.OIDC_OP_USER_ENDPOINT %}OIDC_OP_USER_ENDPOINT={{ answers.OIDC_OP_USER_ENDPOINT }}
{% endif %}
{% if answers.OIDC_OP_LOGOUT_ENDPOINT %}OIDC_OP_LOGOUT_ENDPOINT={{ answers.OIDC_OP_LOGOUT_ENDPOINT }}
{% endif %}
{% if answers.OIDC_OP_INTROSPECTION_ENDPOINT %}OIDC_OP_INTROSPECTION_ENDPOINT={{ answers.OIDC_OP_INTROSPECTION_ENDPOINT }}
{% endif %}
{% if answers.OIDC_OP_URL %}OIDC_OP_URL={{ answers.OIDC_OP_URL }}
{% endif %}
LOGIN_REDIRECT_URL={{ answers.LOGIN_REDIRECT_URL }}
{% if answers.LOGIN_REDIRECT_URL_FAILURE %}LOGIN_REDIRECT_URL_FAILURE={{ answers.LOGIN_REDIRECT_URL_FAILURE }}
{% endif %}
LOGOUT_REDIRECT_URL={{ answers.LOGOUT_REDIRECT_URL }}
{% if answers.ALLOW_LOGOUT_GET_METHOD %}ALLOW_LOGOUT_GET_METHOD={{ answers.ALLOW_LOGOUT_GET_METHOD }}
{% endif %}
{% if answers.DJANGO_CORS_ALLOW_ALL_ORIGINS %}DJANGO_CORS_ALLOW_ALL_ORIGINS={{ answers.DJANGO_CORS_ALLOW_ALL_ORIGINS }}
{% endif %}
{% if answers.DJANGO_CORS_ALLOWED_ORIGINS %}DJANGO_CORS_ALLOWED_ORIGINS={{ answers.DJANGO_CORS_ALLOWED_ORIGINS }}
{% endif %}
{% if answers.DJANGO_CORS_ALLOWED_ORIGIN_REGEXES %}DJANGO_CORS_ALLOWED_ORIGIN_REGEXES={{ answers.DJANGO_CORS_ALLOWED_ORIGIN_REGEXES }}
{% endif %}
{# AWS S3 object storage (django-lasuite default backend) — emitted only when an
   endpoint is set. messages opts out: it uses STORAGE_MESSAGE_* instead and never
   populates these AWS_S3_* answers, so the whole block is skipped for it. #}
{% if answers.AWS_S3_ENDPOINT_URL %}
AWS_S3_ENDPOINT_URL={{ answers.AWS_S3_ENDPOINT_URL }}
AWS_S3_ACCESS_KEY_ID={{ answers.AWS_S3_ACCESS_KEY_ID }}
AWS_S3_SECRET_ACCESS_KEY={{ answers.AWS_S3_SECRET_ACCESS_KEY }}
{% if answers.AWS_S3_REGION_NAME %}AWS_S3_REGION_NAME={{ answers.AWS_S3_REGION_NAME }}
{% endif %}
AWS_STORAGE_BUCKET_NAME={{ answers.AWS_STORAGE_BUCKET_NAME }}
{% if answers.AWS_S3_SIGNATURE_VERSION %}AWS_S3_SIGNATURE_VERSION={{ answers.AWS_S3_SIGNATURE_VERSION }}
{% endif %}
{% if answers.AWS_S3_UPLOAD_POLICY_EXPIRATION %}AWS_S3_UPLOAD_POLICY_EXPIRATION={{ answers.AWS_S3_UPLOAD_POLICY_EXPIRATION }}
{% endif %}
{% if answers.AWS_S3_DOMAIN_REPLACE %}AWS_S3_DOMAIN_REPLACE={{ answers.AWS_S3_DOMAIN_REPLACE }}
{% endif %}
{% endif %}
{% if answers.MEDIA_BASE_URL %}MEDIA_BASE_URL={{ answers.MEDIA_BASE_URL }}
{% endif %}
{# Email (SMTP) — only emitted when configured in bootstrap #}
{% if answers.DJANGO_EMAIL_HOST %}DJANGO_EMAIL_HOST={{ answers.DJANGO_EMAIL_HOST }}
{% endif %}
{% if answers.DJANGO_EMAIL_PORT %}DJANGO_EMAIL_PORT={{ answers.DJANGO_EMAIL_PORT }}
{% endif %}
{% if answers.DJANGO_EMAIL_HOST_USER %}DJANGO_EMAIL_HOST_USER={{ answers.DJANGO_EMAIL_HOST_USER }}
{% endif %}
{% if answers.DJANGO_EMAIL_HOST_PASSWORD %}DJANGO_EMAIL_HOST_PASSWORD={{ answers.DJANGO_EMAIL_HOST_PASSWORD }}
{% endif %}
{% if answers.DJANGO_EMAIL_USE_TLS %}DJANGO_EMAIL_USE_TLS={{ answers.DJANGO_EMAIL_USE_TLS }}
{% endif %}
{% if answers.DJANGO_EMAIL_USE_SSL %}DJANGO_EMAIL_USE_SSL={{ answers.DJANGO_EMAIL_USE_SSL }}
{% endif %}
{% if answers.DJANGO_EMAIL_FROM %}DJANGO_EMAIL_FROM={{ answers.DJANGO_EMAIL_FROM }}
{% endif %}
{% if answers.DJANGO_EMAIL_BRAND_NAME %}DJANGO_EMAIL_BRAND_NAME={{ answers.DJANGO_EMAIL_BRAND_NAME }}
{% endif %}
{% if answers.DJANGO_EMAIL_LOGO_IMG %}DJANGO_EMAIL_LOGO_IMG={{ answers.DJANGO_EMAIL_LOGO_IMG }}
{% endif %}
