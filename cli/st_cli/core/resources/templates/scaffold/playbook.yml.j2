---
# Generated by st-cli — do not edit (regenerated on every deploy).
# Unit: {{ app }}/{{ env }}/{{ component }}  (role {{ role }}, user {{ user }})
#
#   [base]   root: installs podman + the {{ user }} user (needs root; idempotent).
#   [deploy] {{ user }}: renders config + starts the systemd --user unit (no root).
# `st-cli deploy --deploy-only` runs only the [deploy] tag (no root needed).
# The {{ enabled_var }} flag is set ONLY on the deploy task, so the base task
# stays base-only (it must not deploy as root).

- name: "{{ app }}/{{ env }}/{{ component }}"
  hosts: {{ group }}
  serial: 1
  vars_files:
{% for vf in vars_files %}    - {{ vf }}
{% endfor %}
  tasks:
    - name: "Base install ({{ role }}) — root"
      become: true
      become_user: root
      tags: ['base']
      ansible.builtin.import_role:
        name: {{ role }}

    - name: "Deploy {{ component }} — {{ user }}"
      become: true
      become_user: {{ user }}
      become_method: ansible.builtin.sudo
      become_flags: "-i"
      tags: ['deploy']
      ansible.builtin.import_role:
        name: {{ role }}
        tasks_from: deploy.yml
      vars:
        {{ enabled_var }}: true
