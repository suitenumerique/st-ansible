---
{{ ansible_managed | comment }}

name: calendars
services:
  caddy:
    container_name: calendars-caddy
    image: "{{ st_calendars_caddy_image }}:{{ st_calendars_caddy_tag }}"
    env_file: ./caddy_env
    volumes:
      - {{ st_calendars_dir }}/Caddyfile:/etc/caddy/Caddyfile:ro
    ports:
      - "{{ st_calendars_port }}:51000"
    healthcheck:
      test: ["CMD", "curl", "-fsS", "-o", "/dev/null", "http://127.0.0.1:51000/__lbheartbeat__"]
      interval: 10s
      timeout: 5s
      retries: 3
    depends_on:
      backend:
        condition: service_healthy
      frontend:
        condition: service_healthy

  frontend:
    container_name: calendars-frontend
    image: "{{ st_calendars_frontend_image }}:{{ st_calendars_frontend_tag }}"
    healthcheck:
      # The image is distroless: lprobe is its only probe tool.
      test: ["CMD", "/usr/bin/lprobe", "-mode=http", "-port=8080", "-endpoint=/__lbheartbeat__"]
      interval: 10s
      timeout: 5s
      retries: 3

  backend:
    container_name: calendars-backend
    image: "{{ st_calendars_backend_image }}:{{ st_calendars_backend_tag }}"
    env_file: ./backend_env
{% if _st_calendars_backend_secret_files | length > 0 or st_calendars_messages_enabled | bool %}
    environment:
{% for secret in _st_calendars_backend_secret_files %}
      {{ secret.env }}_FILE: /run/secrets/{{ secret.env }}
{% endfor %}
{% if st_calendars_messages_enabled | bool %}
      FEATURE_MESSAGES_INTEGRATION: "true"
      MESSAGES_API_URL: {{ st_calendars_messages_api_url | to_json }}
      MESSAGES_CHANNEL_ID: {{ st_calendars_messages_channel_id | to_json }}
{% endif %}
{% endif %}
{% if _st_calendars_backend_secret_files | length > 0 %}
    volumes:
      - ./secrets:/run/secrets:ro
{% endif %}
    healthcheck:
      # The backend has no heartbeat URL. manage.py check boots the whole Django application.
      test: ["CMD", "python", "manage.py", "check"]
      interval: 30s
      timeout: 60s
      retries: 3
      start_period: 30s

  # SabreDAV. Only the backend calls it, at http://caldav:80 over the compose network.
  caldav:
    container_name: calendars-caldav
    image: "{{ st_calendars_caldav_image }}:{{ st_calendars_caldav_tag }}"
    env_file: ./caldav_env
    healthcheck:
      test: ["CMD", "curl", "-fsS", "-o", "/dev/null", "http://127.0.0.1/caldav/healthz"]
      interval: 10s
      timeout: 5s
      retries: 3
