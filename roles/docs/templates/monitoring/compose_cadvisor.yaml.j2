---
{{ ansible_managed | comment }}
name: cadvisor
services:
  cadvisor:
    container_name: cadvisor
    image: "{{ st_docs_cadvisor_image }}:{{ st_docs_cadvisor_tag }}"
    command:
      - '--podman=unix:///run/podman/podman.sock'
      - --housekeeping_interval=10s
      - --docker_only=true
    privileged: true
    ports:
      - "{{ st_docs_cadvisor_port }}:8080"
    volumes:
      - /:/rootfs:ro
      - ${XDG_RUNTIME_DIR}/podman:/run/podman:ro
      - /dev/disk/:/dev/disk:ro
      - ${HOME}/.local/share/containers:/var/lib/containers:ro
      - /sys/fs/cgroup:/sys/fs/cgroup:ro
      - /etc/machine-id:/etc/machine-id:ro
