{{ ansible_managed | comment }}
{
	admin off
	auto_https off
	log {
		output stdout
		format json
	}
	servers {
		# Trust the front load balancer so the client IP comes from its X-Forwarded-For.
		# CADDY_TRUSTED_PROXIES is an optional CIDR list from the caddy_env file.
		trusted_proxies static {$CADDY_TRUSTED_PROXIES:private_ranges}
		# Walk X-Forwarded-For right to left, so a client cannot set its own client IP.
		trusted_proxies_strict
	}
}

:50600 {
	# Access logs to stdout as JSON.
	log {
		output stdout
		format json
	}

	# Strip proxy/upstream identity headers from every response.
	header {
		-Server
		-Via
	}

	# Health endpoint for the front LB (preserves the old nginx /__lbheartbeat__).
	handle /__lbheartbeat__ {
		respond "ok" 200
	}

	# Object storage — document media (mirrors the upstream ingress /media/ +
	# /media-auth routes).
	handle /media/* {
		route {
			forward_auth docs-backend:8000 {
				uri /api/v1.0/documents/media-auth/
				copy_headers Authorization X-Amz-Date X-Amz-Content-Sha256
				header_up X-Original-URL {http.request.uri}
				# Backend has SECURE_SSL_REDIRECT: without this the auth subrequest
				# is 301'd to https, the browser follows it to media-auth (no
				# X-Original-URL) and 403s.
				header_up X-Forwarded-Proto https
			}
			uri replace /media/ /{$CADDY_S3_BUCKET}/ 1
			header Content-Security-Policy "default-src 'none'"
			reverse_proxy {$CADDY_S3_PROTOCOL}://{$CADDY_S3_HOST} {
				header_up Host {$CADDY_S3_HOST}
			}
		}
	}

	# Collaboration server (mirrors the upstream ingress /collaboration/ws/ +
	# /collaboration/api/ routes). CADDY_YPROVIDER_ENDPOINTS is a REQUIRED,
	# space-separated host:port list from the caddy_env file — caddy substitutes
	# {$VAR} at parse time, so the list expands into multiple upstreams.
	# Room-hash load balancing pins one document to one y-provider replica, since
	# the Yjs document state lives in that replica's memory.
	handle /collaboration/* {
		reverse_proxy {$CADDY_YPROVIDER_ENDPOINTS} {
			lb_policy query room
			header_up X-Forwarded-Proto https
		}
	}

	# Django admin IP allowlist (mirrors the messages Caddyfiles). CADDY_ADMIN_IP_ALLOWLIST
	# is an optional space-separated CIDR list from the caddy_env file: unset allows all,
	# empty denies all. A named matcher keeps this handle before @backend in file order.
	@admin_denied {
		path /admin /admin/* /admin;*
		not client_ip {$CADDY_ADMIN_IP_ALLOWLIST:0.0.0.0/0 ::/0}
	}
	handle @admin_denied {
		respond 403
	}

	# Backend (mirrors the upstream ingress /api, /admin, /external_api, /static routes).
	@backend path /api/* /admin /admin/* /external_api/* /static/*
	handle @backend {
		reverse_proxy docs-backend:8000 {
			header_up X-Forwarded-Proto https
		}
	}

	# Frontend SPA (mirrors ingress / — stock image serves index.html + fallback).
	handle {
		reverse_proxy docs-frontend:8080
	}
}
