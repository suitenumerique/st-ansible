---
{{ ansible_managed | comment }}

name: messages
services:
  frontend:
    container_name: messages-frontend
    image: "{{ st_messages_frontend_image }}:{{ st_messages_tag }}"
    env_file: ./frontend_env
    ports:
      - "{{ st_messages_port }}:8080"
    depends_on:
      backend:
        condition: service_healthy

  backend:
    container_name: messages-backend
    image: "{{ st_messages_backend_image }}:{{ st_messages_tag }}"
    env_file: ./backend_env
    healthcheck:
      test:
        - CMD-SHELL
        - >-
          python -c "import os, urllib.request as u;
          h = os.getenv('DJANGO_ALLOWED_HOSTS', 'localhost').split(',')[0].strip();
          u.urlopen(u.Request('http://localhost:8000/__heartbeat__/',
          headers={'Host': 'localhost' if h == '*' else h,
          'X-Forwarded-Proto': 'https'}), timeout=2)"
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s
