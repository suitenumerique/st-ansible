---
{{ ansible_managed | comment }}

name: messages_workers
services:
  worker:
    container_name: messages-worker
    image: "{{ st_messages_backend_image }}:{{ st_messages_tag }}"
    env_file: ./env
{% if st_messages_workers_secret_files | length > 0 %}
    environment:
{% for secret in st_messages_workers_secret_files %}
      {{ secret.env }}_FILE: /run/secrets/{{ secret.env }}
{% endfor %}
    volumes:
      - ./secrets:/run/secrets:ro
{% endif %}
    # worker.py embeds beat unless it receives --disable-scheduler.
    command: python worker.py --concurrency={{ ansible_processor_nproc }}{% if not st_messages_workers_beat_enabled | bool %} --disable-scheduler{% endif %}
    healthcheck:
      test: ["CMD", "celery", "-A", "messages.celery_app", "inspect", "ping"]
      interval: 1m
      timeout: 10s
      start_interval: 5s
