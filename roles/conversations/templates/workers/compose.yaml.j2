---
{{ ansible_managed | comment }}

name: conversations_workers
services:
  worker:
    container_name: conversations-worker
    image: "{{ st_conversations_backend_image }}:{{ st_conversations_tag }}"
    # The published image sets USER 1001:127:-1000 (upstream CI bug). Podman rejects that gid.
    user: 1001:127
    env_file: ./env
    command: celery -A conversations.celery_app worker --task-events --beat -l INFO -c {{ ansible_processor_nproc }} --schedule=/tmp/celerybeat-schedule
    healthcheck:
      test: ["CMD-SHELL", "celery -A conversations.celery_app inspect ping"]
      interval: 1m
      # The ping imports the whole Django app first. Podman reports -1 past the timeout.
      timeout: 30s
      start_interval: 5s
