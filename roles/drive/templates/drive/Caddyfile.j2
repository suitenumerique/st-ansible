{{ ansible_managed | comment }}
{
	admin off
	auto_https off
	log {
		output stdout
		format json
	}
	servers {
		# Trust the front load balancer so the client IP comes from its X-Forwarded-For.
		# CADDY_TRUSTED_PROXIES is an optional CIDR list from the caddy_env file.
		trusted_proxies static {$CADDY_TRUSTED_PROXIES:private_ranges}
		# Walk X-Forwarded-For right to left, so a client cannot set its own client IP.
		trusted_proxies_strict
	}
}

:50100 {
	# Access logs to stdout as JSON.
	log {
		output stdout
		format json
	}

	# Strip proxy/upstream identity headers from every response.
	header {
		-Server
		-Via
	}

	# Health endpoint for the front LB (preserves the old nginx /__lbheartbeat__).
	handle /__lbheartbeat__ {
		respond "ok" 200
	}

	# Object storage — preview media (mirrors ingress_media_preview.yaml). CSP only; the
	# preview object carries no Content-Disposition, so it renders inline in the browser.
	# More specific than /media/* so Caddy's path-specificity ordering picks it first.
	handle /media/preview/* {
		route {
			forward_auth drive-backend:8000 {
				uri /api/v1.0/items/media-auth/
				copy_headers Authorization X-Amz-Date X-Amz-Content-Sha256
				header_up X-Original-URL {http.request.uri}
				# Backend has SECURE_SSL_REDIRECT: without this the auth subrequest
				# is 301'd to https, the browser follows it to media-auth (no
				# X-Original-URL) and 403s.
				header_up X-Forwarded-Proto https
			}
			uri replace /media/preview/ /{$CADDY_S3_BUCKET}/ 1
			header Content-Security-Policy "default-src 'none'"
			reverse_proxy {$CADDY_S3_PROTOCOL}://{$CADDY_S3_HOST} {
				header_up Host {$CADDY_S3_HOST}
			}
		}
	}

	# Object storage — file media (mirrors ingress_media.yaml). Adds Content-Disposition
	# so the browser saves the file instead of rendering it.
	handle /media/* {
		route {
			forward_auth drive-backend:8000 {
				uri /api/v1.0/items/media-auth/
				copy_headers Authorization X-Amz-Date X-Amz-Content-Sha256
				header_up X-Original-URL {http.request.uri}
				# Backend has SECURE_SSL_REDIRECT: without this the auth subrequest
				# is 301'd to https, the browser follows it to media-auth (no
				# X-Original-URL) and 403s.
				header_up X-Forwarded-Proto https
			}
			uri replace /media/ /{$CADDY_S3_BUCKET}/ 1
			header Content-Security-Policy "default-src 'none'"
			header Content-Disposition attachment
			reverse_proxy {$CADDY_S3_PROTOCOL}://{$CADDY_S3_HOST} {
				header_up Host {$CADDY_S3_HOST}
			}
		}
	}

	# Django admin IP allowlist (mirrors the messages Caddyfiles). CADDY_ADMIN_IP_ALLOWLIST
	# is an optional space-separated CIDR list from the caddy_env file: unset allows all,
	# empty denies all. A named matcher keeps this handle before @backend in file order.
	@admin_denied {
		path /admin /admin/* /admin;*
		not client_ip {$CADDY_ADMIN_IP_ALLOWLIST:0.0.0.0/0 ::/0}
	}
	handle @admin_denied {
		respond 403
	}

	# Backend (mirrors ingress.yaml /api + /external_api, ingress_admin.yaml).
	# /metrics is public only with st_drive_metrics_public. The backend still requires
	# PROMETHEUS_API_KEY as a bearer token on it. This edge is plain HTTP: the token
	# crosses the LB to caddy hop in clear, so that hop must be trusted or tunnelled.
	@backend path /api/* /external_api/* /admin /admin/* /static/*{% if st_drive_metrics_public %} /metrics /metrics/{% endif +%}
	handle @backend {
		reverse_proxy drive-backend:8000 {
			header_up X-Forwarded-Proto https
		}
	}

	# Frontend SPA (mirrors ingress.yaml / — stock image serves index.html + fallback).
	handle {
		reverse_proxy drive-frontend:8080
	}
}
{% if st_drive_metrics_port | length > 0 %}

# Metrics listener, published on st_drive_metrics_port (localhost by default) for a
# scraper on the host. It serves the backend /metrics only. The scraper sends the
# PROMETHEUS_API_KEY bearer token; Caddy passes the Authorization header through.
# Plain HTTP: keep it on loopback, a remote scraper must use an encrypted path.
:50102 {
	header {
		-Server
		-Via
	}

	@metrics path /metrics /metrics/
	handle @metrics {
		reverse_proxy drive-backend:8000 {
			# Django ALLOWED_HOSTS rejects the scraper's 127.0.0.1 Host.
			header_up Host {{ st_drive_public_host }}
			# Backend has SECURE_SSL_REDIRECT: without this the scrape is 301'd to https.
			header_up X-Forwarded-Proto https
		}
	}

	handle {
		respond 404
	}
}
{% endif %}
