---
{{ ansible_managed | comment }}
name: meet_livekit
services:
  caddy:
    container_name: caddy
    image: "{{ st_meet_livekit_caddyl4_image }}:{{ st_meet_livekit_caddyl4_tag }}"
    command: run --config /etc/caddy.yaml --adapter yaml
    network_mode: "host"
    volumes:
      - {{ st_meet_livekit_dir }}/caddy.yaml:/etc/caddy.yaml
      - {{ st_meet_livekit_dir }}/caddy_data:/data
  livekit:
    container_name: livekit
    image: "{{ st_meet_livekit_image }}:{{ st_meet_livekit_tag }}"
    command: --config /etc/livekit.yaml
    network_mode: "host"
{% if st_meet_livekit_valkey_enabled %}
    depends_on:
      valkey:
        condition: service_healthy
{% endif %}
    volumes:
      - {{ st_meet_livekit_dir }}/livekit.yaml:/etc/livekit.yaml
    healthcheck:
      test: wget -q --spider http://localhost:7880
      interval: 10s
      timeout: 3s
{% if st_meet_livekit_valkey_enabled %}
  valkey:
    container_name: valkey
    image: "{{ st_meet_livekit_valkey_image }}:{{ st_meet_livekit_valkey_tag }}"
    network_mode: "host"
    volumes:
      - {{ st_meet_livekit_dir }}/valkey_data:/data
      - {{ st_meet_livekit_dir }}/valkey_config:/usr/local/etc/valkey
    healthcheck:
      test: ["CMD", "valkey-cli", "ping"]
      interval: 10s
      timeout: 3s
      start_period: 10s
{% endif %}