{{ ansible_managed | comment }}

redis:
    address: {{ st_meet_livekit_redis_address }}
    username: "{{ st_meet_livekit_redis_username }}"
    password: "{{ st_meet_livekit_redis_password }}"
    db: 0
    use_tls: false
    sentinel_master_name: ""
    sentinel_username: ""
    sentinel_password: ""
    sentinel_addresses: []
    cluster_addresses: []
    max_redirects: null
api_key: "{{ st_meet_livekit_api_key }}"
api_secret: "{{ st_meet_livekit_api_secret }}"
ws_url: "wss://{{ st_meet_livekit_domain }}"
