---
{{ ansible_managed | comment }}

name: file-scanner
services:
  app:
    container_name: file-scanner-app
    image: "{{ st_file_scanner_image }}:{{ st_file_scanner_tag }}"
    env_file: ./env
    ports:
      - "{{ st_file_scanner_port }}:8090"
    # The published image is distroless but ships its own working HEALTHCHECK
    # (exec-form python urllib GET :8090/check), so the role does not redefine
    # one — a compose-defined probe would be wrapped in `/bin/sh -c` by
    # podman-compose 1.3.0 (Debian Trixie) and fail on the shell-less image.
    depends_on:
      clamav:
        condition: service_healthy
{% if st_file_scanner_exav_enabled %}
      exav:
        condition: service_healthy
{% endif %}

  worker:
    container_name: file-scanner-worker
    image: "{{ st_file_scanner_image }}:{{ st_file_scanner_tag }}"
    env_file: ./env
    # dramatiq worker consuming both queues (webhooks + scans) — required for
    # /scan-async: without it jobs sit in the queue and no webhook is delivered.
    command: ["python", "-m", "worker"]
    depends_on:
      clamav:
        condition: service_healthy
{% if st_file_scanner_exav_enabled %}
      exav:
        condition: service_healthy
{% endif %}
    # The image's HEALTHCHECK probes the web API on :8090, which this worker
    # does not serve; disable it (see the transfers workers unit for the full
    # podman-compose shell-less-image rationale).
    healthcheck:
      disable: true

  clamav:
    container_name: file-scanner-clamav
    image: "{{ st_file_scanner_clamav_image }}:{{ st_file_scanner_clamav_tag }}"
    # clamd/freshclam tuning (st_file_scanner_clamav_env): the image entrypoint
    # applies CLAMD_CONF_<Option>= / FRESHCLAM_CONF_<Option>= lines to
    # clamd.conf / freshclam.conf at startup. Empty file when unconfigured.
    env_file: ./clamav_env
    # Signature database (~300 MB, downloaded by freshclam on first start and
    # kept fresh by the daemon) — persisted so restarts don't re-download it.
    volumes:
      - clamav_data:/var/lib/clamav
    # The clamav image is shell-ful, so the podman-compose `/bin/sh -c` wrapping
    # of this exec-form probe is harmless. The generous start_period covers the
    # first-start signature download + load.
    healthcheck:
      test: ["CMD", "clamdscan", "--ping", "1"]
      interval: 10s
      timeout: 5s
      retries: 30
      start_period: 120s
{% if st_file_scanner_exav_enabled %}

  # Second malware engine (st_file_scanner_exav_enabled). It speaks the clamd
  # protocol on 3310 like clamav, and only scans when the application names it
  # in DEFAULT_SCANNERS with EXAV_HOSTS=exav:3310 — deploying the daemon alone
  # changes no verdict. It ships no signature database: by default it compiles
  # the ones the clamav service keeps fresh (mounted read-only below), which is
  # slow and memory-hungry on every start; EXAV_DB_URL in st_file_scanner_exav_env
  # loads a prebuilt one instead. See the role REFERENCE for both paths.
  exav:
    container_name: file-scanner-exav
    image: "{{ st_file_scanner_exav_image }}:{{ st_file_scanner_exav_tag }}"
    env_file: ./exav_env
    volumes:
      - clamav_data:/var/lib/clamav:ro
      - exav_data:/var/lib/exav
    # Distroless, and the image ships its own HEALTHCHECK (exec-form
    # `/exav --ping`, which only passes once the database is loaded), so the role
    # does not redefine one — podman-compose 1.3.0 (Debian Trixie) wraps a
    # compose-defined probe in `/bin/sh -c`, which fails on a shell-less image.
    depends_on:
      clamav:
        condition: service_healthy
{% endif %}

volumes:
  clamav_data:
{% if st_file_scanner_exav_enabled %}
  exav_data:
{% endif %}
