---
{{ ansible_managed | comment }}

name: file-scanner
services:
  app:
    container_name: file-scanner-app
    image: "{{ st_file_scanner_image }}:{{ st_file_scanner_tag }}"
    env_file: ./env
    ports:
      - "{{ st_file_scanner_port }}:8090"
    # No probe defined here: the image ships a working one, and podman-compose
    # 1.3.0 would wrap a compose-defined probe in `/bin/sh -c` — no shell.
    depends_on:
      clamav:
        condition: service_healthy
{% if st_file_scanner_exav_enabled %}
      # Ordered, NOT gated on health: exav is an optional engine, and a database
      # it cannot load must not keep the API and the worker from starting.
      exav:
        condition: service_started
{% endif %}

  worker:
    container_name: file-scanner-worker
    image: "{{ st_file_scanner_image }}:{{ st_file_scanner_tag }}"
    env_file: ./env
    # dramatiq worker consuming both queues (webhooks + scans) — required for
    # /scan-async: without it jobs sit in the queue and no webhook is delivered.
    command: ["python", "-m", "worker"]
    # Scan scratch: one whole file per in-flight job (MAX_URL_SIZE, 2 GiB), on the
    # host so it can be sized. 1 x 4 jobs, not upstream's 2 x 8, because clamav
    # spools the same bytes again. DOWNLOAD_DIR cannot go in ./env: the API shares
    # it and creates the directory at import time, with no mount for it.
    environment:
      - DOWNLOAD_DIR=/downloads
      - WORKER_PROCESSES={{ st_file_scanner_worker_processes }}
      - WORKER_THREADS={{ st_file_scanner_worker_threads }}
    volumes:
      - ./downloads:/downloads
    depends_on:
      clamav:
        condition: service_healthy
{% if st_file_scanner_exav_enabled %}
      # Ordered, NOT gated on health: exav is an optional engine, and a database
      # it cannot load must not keep the API and the worker from starting.
      exav:
        condition: service_started
{% endif %}
    # The image's HEALTHCHECK probes :8090, which this worker does not serve.
    healthcheck:
      disable: true

  clamav:
    container_name: file-scanner-clamav
    image: "{{ st_file_scanner_clamav_image }}:{{ st_file_scanner_clamav_tag }}"
    # clamd/freshclam tuning (st_file_scanner_clamav_env): the image entrypoint
    # applies CLAMD_CONF_<Option>= / FRESHCLAM_CONF_<Option>= lines to
    # clamd.conf / freshclam.conf at startup. Empty file when unconfigured.
    env_file: ./clamav_env
    # Signature database (~300 MB, downloaded by freshclam on first start and
    # kept fresh by the daemon) — persisted so restarts don't re-download it.
    volumes:
      - clamav_data:/var/lib/clamav
    # The clamav image is shell-ful, so the podman-compose `/bin/sh -c` wrapping
    # of this exec-form probe is harmless. The generous start_period covers the
    # first-start signature download + load.
    healthcheck:
      test: ["CMD", "clamdscan", "--ping", "1"]
      interval: 10s
      timeout: 5s
      retries: 30
      start_period: 120s
{% if st_file_scanner_exav_enabled %}

  # Second malware engine, clamd protocol on 3310. It scans only once the app
  # names it in DEFAULT_SCANNERS with EXAV_HOSTS=exav:3310, and it ships no
  # database: set EXAV_DB_URL, or pay a slow compile of clamav's on every start.
  # See the role REFERENCE.
  exav:
    container_name: file-scanner-exav
    image: "{{ st_file_scanner_exav_image }}:{{ st_file_scanner_exav_tag }}"
    env_file: ./exav_env
    volumes:
      - clamav_data:/var/lib/clamav:ro
      - exav_data:/var/lib/exav
    # No health signal at all, hence `service_started` above: the image's
    # HEALTHCHECK is ignored by podman (`.State.Health` nil — a Docker field in an
    # OCI config), and a compose probe needs a shell this image lacks. Read the
    # logs instead.
    depends_on:
      clamav:
        condition: service_healthy
{% endif %}

volumes:
  clamav_data:
{% if st_file_scanner_exav_enabled %}
  exav_data:
{% endif %}
