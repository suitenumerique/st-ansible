---
{{ ansible_managed | comment }}

name: transfers_workers
services:
  worker:
    container_name: transfers-worker
    image: "{{ st_transfers_backend_image }}:{{ st_transfers_tag }}"
    env_file: ./env
    # worker.py launches a single Celery worker with the beat scheduler embedded
    # (`celery worker --beat --task-events`), so no separate beat container is needed.
    command: ["python", "worker.py"]
    # The backend image ships a built-in HEALTHCHECK that probes gunicorn on :8000,
    # which this worker does not run. The published image is distroless (no /bin/sh), so
    # a compose-defined probe would have to run in exec form (CMD) — but Debian Trixie
    # ships podman-compose 1.3.0, which still wraps even exec-form healthchecks in
    # `/bin/sh -c` (fixed only in podman-compose 1.4.1+), so any probe fails on the
    # shell-less image. Disable the container healthcheck instead (this also overrides
    # the image's :8000 probe); the worker's liveness is observed through its logs /
    # Celery, and nothing depends_on it.
    healthcheck:
      disable: true
