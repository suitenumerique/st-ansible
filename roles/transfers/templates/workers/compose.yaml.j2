---
{{ ansible_managed | comment }}

name: transfers_workers
services:
  worker:
    container_name: transfers-worker
    image: "{{ st_transfers_backend_image }}:{{ st_transfers_tag }}"
    env_file: ./env
    # worker.py launches a single Celery worker with the beat scheduler embedded
    # (`celery worker --beat --task-events`), so no separate beat container is needed.
    command: ["python", "worker.py"]
    # The image's own probe targets gunicorn on :8000, which this worker does not
    # run, so Celery's ping replaces it. It is a broadcast on the broker: with
    # several hosts on one Redis, another host's worker can answer for this one.
    healthcheck:
      test: ["CMD", "celery", "-A", "transfers.celery_app", "inspect", "ping"]
      interval: 1m
      timeout: 10s
      start_interval: 5s
